# Build próprio (com.matheus.readest): servidor self-hosted no VPS, premium liberado
# pelo modo self-hosted e sem telemetria. Carregado por scripts/build-proprio.sh.
NEXT_PUBLIC_SELF_HOSTED=true
NEXT_PUBLIC_API_BASE_URL=https://readest.pulsobot.duckdns.org
NEXT_PUBLIC_NODE_BASE_URL=https://readest.pulsobot.duckdns.org
NEXT_PUBLIC_SUPABASE_URL=https://readest-api.pulsobot.duckdns.org
# NEXT_PUBLIC_SUPABASE_ANON_KEY: definido na fase 2, junto com o servidor

# Sem PostHog e sem Sentry
NEXT_PUBLIC_DEFAULT_POSTHOG_KEY_BASE64=
NEXT_PUBLIC_DEFAULT_POSTHOG_URL_BASE64=
SENTRY_DSN=
